# Optional: run the web page automatically at login (systemd user service).
#   mkdir -p ~/.config/systemd/user && cp ipc-assistant.service ~/.config/systemd/user/
#   edit the two paths below if the repo is not cloned in your home folder, then:  systemctl --user enable --now ipc-assistant
[Unit]
Description=IPC Section Assistant (offline legal AI)
After=graphical-session.target

[Service]
WorkingDirectory=%h/Deep_learning_end_sem_project/app
ExecStart=%h/Deep_learning_end_sem_project/app/run_app.sh
Restart=on-failure

[Install]
WantedBy=default.target
